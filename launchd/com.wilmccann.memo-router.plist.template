<?xml version="1.0" encoding="UTF-8"?>
<!--
  Memo Router timer. SPEC.md section 4.1.

  Template, not the installed file: bin/install-launchagent.sh replaces the
  placeholders with real paths and writes the result to
  ~/Library/LaunchAgents/com.wilmccann.memo-router.plist.

  StartInterval rather than StartCalendarInterval because launchd then runs a
  missed interval when the Mac wakes, instead of skipping it. RunAtLoad is
  false so installing it does not immediately fire a run.

  The interval is four minutes by default. Each firing is a cheap check of
  the Sheet (see the precheck in bin/process-memos.sh); the agent itself only
  launches when that check finds a row waiting.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wilmccann.memo-router</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__ROOT__/bin/process-memos.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__ROOT__</string>

    <key>StartInterval</key>
    <integer>__INTERVAL__</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PATH__</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__ROOT__/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__ROOT__/logs/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
