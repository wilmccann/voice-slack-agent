# Copy this file to .env in the same folder and fill in the four values.
# That file is gitignored and must stay that way (CLAUDE.md rule 1). Nothing
# here is a real value; this file is the only one of the pair that is committed.
#
# Who reads what:
#   mcp/sheet-server.js   MEMO_WEBAPP_URL, WEBHOOK_SECRET
#   mcp/slack-server.js   SLACK_BOT_TOKEN, SLACK_DM_USER_ID
#   receiver/capture.js   WEBHOOK_SECRET
#   test/check-receiver.sh   MEMO_WEBAPP_URL, WEBHOOK_SECRET
#
# bin/process-memos.sh deliberately reads none of them. The servers load their
# own credentials so no secret is ever in the runner's environment (rule 2).

# The shared secret the phone app sends with every memo, and that the agent
# sends back when it reads or writes the Sheet. Generate a fresh one with:
#   openssl rand -hex 32
# The same value goes into the Apps Script project under
# Project Settings -> Script Properties -> WEBHOOK_SECRET.
WEBHOOK_SECRET=

# The Apps Script web app /exec URL, from Deploy -> New deployment -> Web app.
# This is itself a secret (rule 3): anyone holding it can write memos as Will.
# It ends in /exec, not /dev. Do not add a query string here.
MEMO_WEBAPP_URL=

# Slack bot token for the app that sends the DM, starting xoxb-.
# Scopes needed, and no others (rule 5): chat:write, im:write
SLACK_BOT_TOKEN=

# Will's own Slack member id, the only place a DM can go. Find it in Slack
# under Profile -> More -> Copy member ID. It starts with U.
SLACK_DM_USER_ID=
