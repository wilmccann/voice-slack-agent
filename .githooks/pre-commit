#!/usr/bin/env bash
# Blocks a commit whose staged changes contain anything shaped like a secret.
# Enable once per clone:  git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Refusing to commit without a secret scan." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
